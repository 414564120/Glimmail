DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glimmail"
# AUTH_SECRET is reserved for future use (current sessions are DB-backed opaque tokens).
AUTH_SECRET="replace-with-a-long-random-secret"
# Default owner credentials used by `pnpm db:seed`.
GLIMMAIL_ADMIN_EMAIL="owner@aethermail.local"
GLIMMAIL_ADMIN_PASSWORD="replace-with-a-strong-password"
ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MAIL163_IMAP_HOST="imap.163.com"
MAIL163_IMAP_PORT="993"
